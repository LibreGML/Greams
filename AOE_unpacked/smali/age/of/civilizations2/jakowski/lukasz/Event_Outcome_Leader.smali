    .locals 2

    iget v0, p0, Lage/of/civilizations2/jakowski/lukasz/Event_Outcome_Leader;->iCivID:I

    const/4 v1, 0x1

    if-ne v0, p1, :cond_0

    const/4 v0, -0x1

    iput v0, p0, Lage/of/civilizations2/jakowski/lukasz/Event_Outcome_Leader;->iCivID:I

    return v1

    :cond_0
    if-ge p1, v0, :cond_1

    sub-int/2addr v0, v1

    iput v0, p0, Lage/of/civilizations2/jakowski/lukasz/Event_Outcome_Leader;->iCivID:I

    :cond_1
    const/4 v0, 0x0

    return v0
.end method
